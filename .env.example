# העתיקו לקובץ .env.local (מקומי) או הגדירו ב-Vercel → Settings → Environment Variables

# מזהה המפרסם שלכם ב-AdSense (ca-pub-XXXXXXXXXXXXXXXX)
NEXT_PUBLIC_ADSENSE_CLIENT=

# כתובת האתר המלאה כולל נתיב הבסיס (OG / sitemap / קישורי וואטסאפ)
NEXT_PUBLIC_SITE_URL=https://yummio.co.il/menus

# נתיב הבסיס שהאפליקציה מוגשת תחתיו (למשל /menus כדי לרוץ על yummio.co.il/menus).
# השאירו ריק כדי לרוץ בשורש (פיתוח מקומי).
NEXT_PUBLIC_BASE_PATH=/menus

# ===== לוח הניהול (/admin) =====
# סיסמה לכניסה ללוח הניהול (בחרו סיסמה חזקה)
ADMIN_PASSWORD=

# GitHub Personal Access Token (fine-grained) עם הרשאת Contents: Read & Write על מאגר yummio
GITHUB_TOKEN=

# המאגר בפורמט owner/repo (אם שונה מברירת המחדל)
GITHUB_REPO=sfiras/yummio
